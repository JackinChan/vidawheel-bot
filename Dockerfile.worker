# Employee-side worker image. Keep model login in its dedicated mounted volume.
FROM node:22-bookworm-slim AS node
RUN npm install --global @openai/codex@0.166.0
FROM vidawheel-bot-mcp:latest
USER root
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY analysis_worker /app/analysis_worker
RUN ln -sf ../lib/node_modules/@openai/codex/bin/codex.js /usr/local/bin/codex \
    && mkdir -p /home/bot/.codex && chown bot:bot /home/bot/.codex
USER bot
CMD ["python", "-m", "analysis_worker.main"]
